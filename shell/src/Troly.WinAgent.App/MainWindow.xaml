<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Troly.WinAgent.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Troly">
    <Grid x:Name="Root" Background="{ThemeResource TrolyCanvasBrush}">
        <StackPanel Padding="24" Spacing="16" MaxWidth="460"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <Image x:Name="BrandLogo" Height="64" HorizontalAlignment="Left" Stretch="Uniform" AutomationProperties.Name="Troly" />
            <ComboBox x:Name="AppearancePicker" Header="Appearance" HorizontalAlignment="Stretch" SelectionChanged="AppearancePicker_SelectionChanged">
                <ComboBoxItem Content="System" Tag="system" />
                <ComboBoxItem Content="Light" Tag="light" />
                <ComboBoxItem Content="Dark" Tag="dark" />
            </ComboBox>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap"
                       Foreground="{ThemeResource TrolyMutedBrush}"
                       Text="Starting…" />
            <TextBox x:Name="EmailBox" Header="Email" PlaceholderText="you@troly.me" />
            <PasswordBox x:Name="PasswordBox" Header="Password" />
            <Button x:Name="SignInButton" Content="Sign in" Click="SignInButton_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" MinHeight="44" />
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{ThemeResource TrolyTextBrush}" />
        </StackPanel>
    </Grid>
</Window>
